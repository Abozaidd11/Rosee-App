# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Yarn v4 / PnP (avoid OS-specific conflicts)
.pnp.cjs 
.pnp.loader.mjs
yarn.lock

# dependencies
/node_modules
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Yarn v4
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Exclude SDK files (they're large and can be regenerated)
.yarn/sdks
.yarn/unplugged